# ============================================================================
# {{App}} — environment template
# ============================================================================
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
# The complete list of variables and their contract is in SPEC-config.md.
#
# Local: load it with `direnv allow` (or your dotenv loader).
# Production: the deploy platform (Coolify, Fly, Render…) injects these
# variables into the container — they are not baked into the image.
# ============================================================================

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------

# Listen port. Must match the resource's "Ports Exposes" in the deploy platform.
PORT=4000

# Public host (no scheme, no port). LAN/VPN: the app's host.
PHX_HOST=localhost

# External port of the generated URLs (443 with TLS; 4000/5000 behind a VPN).
PHX_PORT=443

# Scheme of the generated URLs. `http` when there is no TLS terminator in front.
PHX_SCHEME=https

# Turns Plug.SSL off — it is COMPILE-TIME: passed as a build arg, not at runtime.
# DISABLE_FORCE_SSL=1     (build only; with this, also set PHX_SCHEME=http)

# Signs/encrypts cookies and secrets. At least 64 bytes — the boot fails on a
# shorter one.  mix phx.gen.secret
SECRET_KEY_BASE=replace-me-with-output-of-mix-phx-gen-secret

# Ecto connection.
# Local:      ecto://postgres:postgres@localhost/{{app}}_dev
# Production: postgres://user:***@host/{{app}}_prod
DATABASE_URL=ecto://postgres:postgres@localhost/{{app}}_dev

# Connection pool (default 10).
POOL_SIZE=10

# TLS to the database: encrypted by default WITHOUT verification (managed
# databases use self-signed certificates). ECTO_SSL=false turns it off;
# ECTO_SSL_VERIFY=true enables strict verification against the system bundle.
# ECTO_SSL=false
# ECTO_IPV6=false

# ----------------------------------------------------------------------------
# Session
# ----------------------------------------------------------------------------
# Read at RUNTIME (config/runtime.exs → {{App}}Web.Endpoint.session_options/0),
# so a rotation needs a restart, not a rebuild.

# Session cookie salts — TWO DIFFERENT ONES, mandatory in production (the boot
# fails without them, and fails too if they are equal).  mix phx.gen.secret 32
SESSION_SIGNING_SALT=dev-signing-salt-not-for-prod
SESSION_ENCRYPTION_SALT=dev-encryption-salt-not-for-prod

# Force/clear the cookie's Secure flag explicitly. Production HTTPS defaults to
# secure=true; production PHX_SCHEME=http and local dev default to off.
# SESSION_COOKIE_SECURE=true

# Session lifetime in seconds, a positive integer (default 31536000, with
# sliding renewal). An invalid value aborts the boot.
# SESSION_MAX_AGE_SECONDS=31536000

# CSRF/WS: list of allowed origins when the app is reachable through more than
# one scheme/host/port. Format scheme://host:port, comma-separated.
# CHECK_ORIGINS=https://{{app}}.example.com,http://10.0.0.5:4000

# Trust the X-Forwarded-* headers (peer IP, scheme, host, port). Enable ONLY
# when the container is unreachable except through the proxy and the proxy
# strips those headers: otherwise any client can claim any origin/IP.
# Default: off.
# TRUST_PROXY=1

# ----------------------------------------------------------------------------
# UI
# ----------------------------------------------------------------------------

# daisyUI theme the app renders with (DESIGN.md §C2). Chosen at RUNTIME: the CSS
# compiles the family's set, so switching it needs no rebuild — only a restart.
# Unknown values fall back to `dim` and log a warning.
# Built-ins: dim, light, dark, cupcake, bumblebee, emerald, corporate, synthwave,
# retro, cyberpunk, valentine, halloween, garden, forest, aqua, lofi, pastel,
# fantasy, wireframe, black, luxury, dracula, cmyk, autumn, business, acid,
# lemonade, night, coffee, winter, nord, sunset, caramellatte, abyss, silk.
# THEME=dim

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------

# Google sign-in (empty = disabled).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://{{app}}.example.com/auth/google/callback
# Restrict self-registration to these verified email domains (comma-separated).
# Empty = only existing users can sign in. A blank or malformed entry fails boot.
# GOOGLE_OAUTH_ALLOWED_DOMAINS=example.com

# Distributed Erlang clustering (empty = single instance).
# DNS_CLUSTER_QUERY=

# Container setup (docker/entrypoint.sh → {{App}}.Release.setup/0).
# Skips the setup entirely (one-off task containers).
# SKIP_MIGRATIONS=1
# Do not try to create the database: it is preprovisioned, or the role has no
# CREATEDB privilege (managed providers). The setup then only migrates + seeds.
# SKIP_DB_CREATE=1
# Bound for create+migrate+seed in seconds (default 120): on timeout the
# container fails instead of hanging.
# SETUP_TIMEOUT_SECONDS=120

# ----------------------------------------------------------------------------
# Variables of {{App}} itself — declare them here and read them in runtime.exs
# with an explicit default (see SPEC-config.md §The app's own variables).
# ----------------------------------------------------------------------------
