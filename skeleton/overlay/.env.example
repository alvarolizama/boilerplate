# ============================================================================
# {{App}} — environment template
# ============================================================================
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
# The complete list of variables and their contract is in SPEC-config.md.
#
# Local: load it with `direnv allow` (or your dotenv loader).
# Production: the deploy platform (Coolify, Fly, Render…) injects these
# variables into the container — they are not baked into the image.
# ============================================================================

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------

# Listen port. Must match the resource's "Ports Exposes" in the deploy platform.
PORT=4000

# Public host (no scheme, no port). LAN/VPN: the app's host.
PHX_HOST=localhost

# External port of the generated URLs (443 with TLS; 4000/5000 behind a VPN).
PHX_PORT=443

# Scheme of the generated URLs. `http` when there is no TLS terminator in front.
PHX_SCHEME=https

# Turns Plug.SSL off — it is COMPILE-TIME: passed as a build arg, not at runtime.
# DISABLE_FORCE_SSL=1     (build only; with this, also set PHX_SCHEME=http)

# Signs/encrypts cookies and secrets.  mix phx.gen.secret
SECRET_KEY_BASE=replace-me-with-output-of-mix-phx-gen-secret

# Ecto connection.
# Local:      ecto://postgres:postgres@localhost/{{app}}_dev
# Production: postgres://user:***@host/{{app}}_prod
DATABASE_URL=ecto://postgres:postgres@localhost/{{app}}_dev

# Connection pool (default 10).
POOL_SIZE=10

# TLS to the database: encrypted by default WITHOUT verification (managed
# databases use self-signed certificates). ECTO_SSL=false turns it off;
# ECTO_SSL_VERIFY=true enables strict verification against the system bundle.
# ECTO_SSL=false
# ECTO_IPV6=false

# ----------------------------------------------------------------------------
# Session
# ----------------------------------------------------------------------------

# Session cookie salts — TWO DIFFERENT ONES, mandatory in production (the boot
# fails without them).  mix phx.gen.secret 32
SESSION_SIGNING_SALT=dev-signing-salt-not-for-prod
SESSION_ENCRYPTION_SALT=dev-encryption-salt-not-for-prod

# Force the cookie's Secure flag (HTTPS-only). Default: Plug decides per
# request, so an HTTP deploy keeps working.
# SESSION_COOKIE_SECURE=true

# Session lifetime in seconds (default 31536000, with sliding renewal).
# SESSION_MAX_AGE_SECONDS=31536000

# CSRF/WS: list of allowed origins when the app is reachable through more than
# one scheme/host/port. Format scheme://host:port, comma-separated.
# CHECK_ORIGINS=https://{{app}}.example.com,http://10.0.0.5:4000

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------

# Google sign-in (empty = disabled).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://{{app}}.example.com/auth/google/callback

# Distributed Erlang clustering (empty = single instance).
# DNS_CLUSTER_QUERY=

# Skips the entrypoint's setup (one-off task containers).
# SKIP_MIGRATIONS=1

# ----------------------------------------------------------------------------
# Variables of {{App}} itself — declare them here and read them in runtime.exs
# with an explicit default (see SPEC-config.md §The app's own variables).
# ----------------------------------------------------------------------------